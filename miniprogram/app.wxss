page { background: #f7f5ef; color: #29392e; font-size: 28rpx; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
view, button, input { box-sizing: border-box; }
button { font-size: 28rpx; }
button::after { border: none; }
.page { padding: 36rpx 32rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #788274; font-size: 22rpx; letter-spacing: 3rpx; }
.title { font-size: 46rpx; font-weight: 700; line-height: 1.4; letter-spacing: 1rpx; margin-top: 12rpx; color: #263d2d; }
.muted { color: #788274; font-size: 25rpx; line-height: 1.7; }
.notice { margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 16rpx; color: #7b6746; background: #eee8db; font-size: 23rpx; line-height: 1.6; }
.panel { background: #fffefb; border: 1rpx solid #e7e7df; border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx; }
.section-title { font-size: 31rpx; font-weight: 700; letter-spacing: .5rpx; margin-bottom: 20rpx; color: #304735; }
.primary { background: #365b41; color: #fff; border-radius: 18rpx; margin-top: 24rpx; }
.empty { text-align: center; padding: 72rpx 24rpx; }
.page button.primary { width: 100%; max-width: none; padding: 20rpx 24rpx; line-height: 1.6; margin-left: 0; margin-right: 0; font-weight: normal; }
.page button.secondary { width: 100%; margin: 24rpx 0 0; padding: 18rpx 24rpx; line-height: 1.6; font-size: 26rpx; font-weight: normal; background: #edf0e6; color: #365b41; border-radius: 16rpx; }
