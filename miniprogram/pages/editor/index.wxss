.label { margin: 24rpx 0 12rpx; font-size: 26rpx; }
.field { width: 100%; background: #f8f8f3; border: 1rpx solid #dfe4d8; border-radius: 14rpx; padding: 20rpx; font-size: 27rpx; min-height: 80rpx; color: #304735; }
input.field { height: 84rpx; box-sizing: border-box; padding: 0 20rpx; line-height: 84rpx; }
.picker { line-height: 1.6; display: flex; align-items: center; justify-content: space-between; }
.picker-arrow { color: #687060; font-size: 25rpx; line-height: 1; margin-left: auto; padding-left: 20rpx; transform: translateY(-2rpx); }
.row, .ingredient-row { display: flex; align-items: center; }
.half { width: calc(50% - 6rpx); }
.half + .half { margin-left: 12rpx; }
.ingredient-row { margin-top: 18rpx; }
.ingredient-name { flex: 1.2; min-width: 0; }
.ingredient-amount { flex: 1; min-width: 0; margin-left: 12rpx; }
.page button.remove { width: auto; flex-shrink: 0; padding: 12rpx; margin: 0 0 0 8rpx; background: transparent; color: #986052; font-size: 23rpx; line-height: 1.6; font-weight: normal; }
.page button.secondary { width: 100%; margin: 24rpx 0 0; padding: 18rpx; line-height: 1.6; font-size: 26rpx; font-weight: normal; background: #edf0e6; color: #365b41; border-radius: 12rpx; }
.step-edit { margin-top: 24rpx; }
.step-heading { justify-content: space-between; margin-bottom: 12rpx; font-size: 25rpx; }
.textarea { min-height: 150rpx; line-height: 1.7; }
.error { color: #983e2d; background: #fae9e2; }
