.field { width: 100%; height: 84rpx; padding: 20rpx; margin-top: 16rpx; font-size: 27rpx; background: #f7f7f1; border: 1rpx solid #e3e6dc; border-radius: 12rpx; }
.shopping-row { display: flex; align-items: center; border-bottom: 1rpx solid #efefe9; padding: 16rpx 0; }
.shopping-row:last-child { border: none; }
.page button.item-toggle { display: flex; align-items: center; flex: 1; width: auto; min-width: 0; padding: 12rpx 0; margin: 0; background: transparent; color: #29392e; text-align: left; font-weight: normal; line-height: 1.6; }
.check-mark { font-size: 38rpx; width: 50rpx; flex-shrink: 0; color: #365b41; }
.item-info { flex: 1; min-width: 0; overflow-wrap: break-word; }
.item-name { font-size: 29rpx; }
.amount { color: #526749; font-size: 26rpx; }
.source { color: #788274; font-size: 22rpx; margin-top: 6rpx; }
.completed .item-name { text-decoration: line-through; color: #788274; }
.page button.remove { width: auto; flex-shrink: 0; padding: 12rpx; margin: 0 0 0 8rpx; background: transparent; color: #986052; font-size: 23rpx; line-height: 1.6; font-weight: normal; }
